{
  // Intended Worker for techdata. Not deployed: deploy is owner-approved and
  // manual (.github/workflows/deploy.yml, workflow_dispatch only).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techdata",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    "PODCASTS_API_BASE": "https://api.podcasts.highsignal.app/api"
  }
}
