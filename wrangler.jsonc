{
  // Public techdata Worker; the R2 bucket has no public endpoint. Deploy is owner-approved and
  // manual (.github/workflows/deploy.yml, workflow_dispatch only).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techdata",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/nomad/",
      "/nomad",
      "/nomad/notes/",
      "/nomad/notes",
      "/papers/authors/",
      "/papers/authors",
      "/papers/cited/",
      "/papers/cited",
      "/papers/",
      "/papers",
      "/papers/paths/",
      "/papers/paths",
      "/ph/",
      "/ph",
      "/podcasts/claims/",
      "/podcasts/claims",
      "/podcasts/",
      "/podcasts",
      "/podcasts/people/",
      "/podcasts/people",
      "/reddit/",
      "/reddit",
      "/reddit/posts/",
      "/reddit/posts",
      "/*.md",
      "/api/md",
      "/api/md/*",
      "/api/ai",
      "/llms.txt",
      "/llms-full.txt",
      "/ai.txt",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "workers_dev": true,
  "routes": [{ "pattern": "data.highsignal.app", "custom_domain": true }],
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "techdata-data" }],
  "observability": { "enabled": true },
  "vars": {
    "PODCASTS_API_BASE": "https://api.podcasts.highsignal.app/api"
  }
}
