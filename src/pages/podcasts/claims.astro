---
import { createPodcastsAdapter } from "../../adapters/podcasts";
import ClaimsView from "../../components/podcasts/ClaimsView";
import Console from "../../layouts/Console.astro";

const initial = await createPodcastsAdapter({
  fetch: (url, init) => fetch(url, { ...init, signal: AbortSignal.timeout(15000) }),
})
  .claims(new URLSearchParams())
  .catch(() => undefined);
---

<Console
  title="claims · podcasts"
  heading="claims"
  description="Published claims with the verbatim quote, the verified speaker, the episode and, for captioned episodes, the timestamp. Read live from the High Signal Podcasts public API."
  nav="podcasts-claims"
  breadcrumbs={[{ label: "podcasts", href: "/podcasts/claims/" }, { label: "claims" }]}
>
  <ClaimsView initial={initial} client:load />
</Console>
