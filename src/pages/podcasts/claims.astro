---
import { publicBuildSnapshot } from "../../lib/public-build-snapshot";
import { publicPageCopy } from "../../lib/public-page-copy";

const publicPage = publicPageCopy["/podcasts/claims/"];

import ClaimsView from "../../components/podcasts/ClaimsView";
import Console from "../../layouts/Console.astro";

const initial = publicBuildSnapshot.claims ?? undefined;
---

<Console
  title={publicPage.title}
  heading={publicPage.heading}
  description={publicPage.description}
  nav="podcasts-claims"
  breadcrumbs={[{ label: "podcasts", href: "/podcasts/claims/" }, { label: "claims" }]}
>
  <ClaimsView initial={initial} client:load />
</Console>
