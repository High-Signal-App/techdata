---
import Console from "../../../layouts/Console.astro";
import { podcastPublication } from "../../../server/podcast-publication";

export const prerender = false;
let failed = false;
const result = await podcastPublication.catalog(Astro.params.page ?? "").catch(() => {
  failed = true;
  return null;
});
const page = Number(Astro.params.page);
const totalPages = Math.ceil((result?.data.total ?? 0) / 100);
Astro.response.status = failed ? 503 : result ? 200 : 404;
Astro.response.headers.set("Cache-Control", result ? "public, max-age=60" : "no-store");
if (!result) Astro.response.headers.set("X-Robots-Tag", "noindex");
---
<Console title={`Podcast episode catalog · page ${result ? page : "unavailable"}`} heading="Podcast episode catalog" description="Read published podcast claims in their episode context, with the original source, publication date and verified speaker attribution." nav="podcasts-episodes" breadcrumbs={[{ label: "podcasts", href: "/podcasts/" }, { label: "episode catalog" }]} noindex={!result}>
  <div class="max-w-4xl space-y-6">
    {result ? <>
      <p class="text-sm text-muted-foreground">The public API reports {result.data.total.toLocaleString("en-US")} episodes with published claims. Retrieved {result.provenance.fetchedAt}. Withheld shows are excluded by the source; missing speaker attribution stays unverified.</p>
      <nav aria-label="Episode catalog pages" class="flex flex-wrap gap-4 text-sm"><a class="underline" href="/podcasts/catalog/">All episode catalog pages</a>{page > 1 && <a class="underline" href={`/podcasts/catalog/${page - 1}/`} rel="prev">Previous</a>}<span>Page {page} of {totalPages}</span>{page < totalPages && <a class="underline" href={`/podcasts/catalog/${page + 1}/`} rel="next">Next</a>}</nav>
      <ol class="divide-y divide-border">{result.data.sources.map((episode) => <li class="py-5 space-y-2"><h2 class="font-medium"><a class="underline underline-offset-4" href={`/podcasts/episodes/${encodeURIComponent(episode.id)}/`}>{episode.title}</a></h2><p class="text-sm text-muted-foreground">{episode.showName} · published {episode.publishedAt?.slice(0, 10)} · {episode.claimCount} published claims</p></li>)}</ol>
      <nav aria-label="Continue episode catalog" class="flex flex-wrap gap-4 text-sm">{page > 1 && <a class="underline" href={`/podcasts/catalog/${page - 1}/`}>Previous page</a>}{page < totalPages && <a class="underline" href={`/podcasts/catalog/${page + 1}/`}>Next page</a>}</nav>
    </> : <p>{failed ? "The public episode source could not be verified. Please retry later." : "This catalog page does not exist."} <a class="underline" href="/podcasts/">Return to the podcast workbench.</a></p>}
  </div>
</Console>
