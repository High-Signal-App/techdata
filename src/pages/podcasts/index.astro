---
import { publicBuildSnapshot } from "../../lib/public-build-snapshot";
import { publicPageCopy } from "../../lib/public-page-copy";

const publicPage = publicPageCopy["/podcasts/"];

import EpisodesView from "../../components/podcasts/EpisodesView";
import Console from "../../layouts/Console.astro";

const initial = publicBuildSnapshot.episodes ?? undefined;
---

<Console
  title={publicPage.title}
  heading={publicPage.heading}
  description={publicPage.description}
  nav="podcasts-episodes"
  breadcrumbs={[{ label: "podcasts", href: "/podcasts/claims/" }, { label: "episodes" }]}
>
  <EpisodesView initial={initial} client:load />
</Console>
