---
import { createPodcastsAdapter } from "../../adapters/podcasts";
import EpisodesView from "../../components/podcasts/EpisodesView";
import Console from "../../layouts/Console.astro";

const initial = await createPodcastsAdapter({
  fetch: (url, init) => fetch(url, { ...init, signal: AbortSignal.timeout(15000) }),
})
  .episodes(new URLSearchParams({ limit: "50" }))
  .catch(() => undefined);
---

<Console
  title="episodes · podcasts"
  heading="episodes"
  description="Podcast episodes with at least one published claim, newest first. Read live from the High Signal Podcasts public API."
  nav="podcasts-episodes"
  breadcrumbs={[{ label: "podcasts", href: "/podcasts/claims/" }, { label: "episodes" }]}
>
  <EpisodesView initial={initial} client:load />
</Console>
