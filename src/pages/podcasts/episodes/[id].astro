---
import { speakerLabel, transcriptLabel, UpstreamError } from "../../../adapters/podcasts";
import Console from "../../../layouts/Console.astro";
import { safeWebUrl } from "../../../lib/ph-publication";
import { podcastPublication } from "../../../server/podcast-publication";

export const prerender = false;
let failed = false;
const result = await podcastPublication.episode(Astro.params.id ?? "").catch((error: unknown) => {
  failed = !(error instanceof UpstreamError && error.status === 404);
  return null;
});
const episode = result?.data.source;
const claims = result?.data.claims ?? [];
Astro.response.status = failed ? 503 : episode ? 200 : 404;
Astro.response.headers.set("Cache-Control", episode ? "public, max-age=60" : "no-store");
if (!episode) Astro.response.headers.set("X-Robots-Tag", "noindex");
const description = episode
  ? `${episode.showName}: ${episode.title}. ${claims.length} published claims with source attribution and episode context.`
  : "This episode is unavailable from the published podcast collection.";
---
<Console title={episode?.title ?? "Episode unavailable"} heading={episode?.title ?? "Episode unavailable"} description={description} nav="podcasts-episodes" breadcrumbs={[{ label: "podcasts", href: "/podcasts/" }, { label: "episode catalog", href: "/podcasts/catalog/" }, { label: "episode" }]} noindex={!episode}>
  {episode && result ? <article class="max-w-3xl space-y-6">
    <section class="rounded-lg border border-border p-5 space-y-3 text-sm">
      <h2 class="text-base font-medium">Episode context</h2>
      <p>{episode.showName} · published <time datetime={episode.publishedAt ?? undefined}>{episode.publishedAt?.slice(0, 10)}</time> · {transcriptLabel(episode.transcriptKind)}</p>
      <p>{claims.length} published claims are available from this episode. Speaker names appear only when verified by the source API.</p>
      <div class="flex flex-wrap gap-4"><a class="underline" href={safeWebUrl(episode.sourceUrl) ?? "https://podcasts.highsignal.app/"} rel="noreferrer">Original episode</a><a class="underline" href={`/podcasts/?episode=${encodeURIComponent(episode.id)}`}>Explore episode in the workbench</a></div>
    </section>
    <section class="space-y-4" aria-labelledby="claims-heading">
      <h2 id="claims-heading" class="text-base font-medium">Published claims</h2>
      <p class="text-xs text-muted-foreground">These are source-extracted assertions, not independently verified facts. Open a claim in the workbench to inspect its quote and evidence.</p>
      <ol class="divide-y divide-border">{claims.map((claim) => <li class="py-4 space-y-2"><p class="leading-7 break-words">{claim.assertion}</p><p class="text-xs text-muted-foreground">{speakerLabel(claim)} · {claim.claimType}{claim.saidOn ? ` · ${claim.saidOn.slice(0, 10)}` : ""}</p><a class="text-sm underline" href={`/podcasts/claims/?claim=${encodeURIComponent(claim.id)}`}>Read quote and source evidence</a>{safeWebUrl(claim.deepLinkUrl) && <a class="ml-4 text-sm underline" href={safeWebUrl(claim.deepLinkUrl)} rel="noreferrer">Listen at the source</a>}</li>)}</ol>
    </section>
    <section class="space-y-2 text-xs text-muted-foreground"><h2 class="text-base font-medium text-foreground">Source and retrieval</h2><p>High Signal Podcasts public API · retrieved <time datetime={result.provenance.fetchedAt}>{result.provenance.fetchedAt}</time>. This is a live published-only read; withheld shows are excluded by the source. The original transcript collection date is not supplied.</p><a class="underline" href={result.provenance.viaUrl}>Public episode data</a></section>
    <a class="inline-block underline" href="/podcasts/catalog/">Browse more podcast episodes</a>
  </article> : <div class="space-y-4"><p>{failed ? "The public source could not be verified. Please retry later." : "This episode is not available in the published collection."}</p><a class="underline" href="/podcasts/catalog/">Browse published episodes</a></div>}
</Console>
