---
import { createPodcastsAdapter } from "../../adapters/podcasts";
import PeopleView from "../../components/podcasts/PeopleView";
import Console from "../../layouts/Console.astro";

const initial = await createPodcastsAdapter({
  fetch: (url, init) => fetch(url, { ...init, signal: AbortSignal.timeout(15000) }),
})
  .people(new URLSearchParams({ limit: "50", offset: "0" }))
  .catch(() => undefined);
---

<Console
  title="people · podcasts"
  heading="people"
  description="Verified speakers with published claims, most claims first. Unverified speakers are labelled on their claims and never listed here."
  nav="podcasts-people"
  breadcrumbs={[{ label: "podcasts", href: "/podcasts/claims/" }, { label: "people" }]}
>
  <PeopleView initial={initial} client:load />
</Console>
