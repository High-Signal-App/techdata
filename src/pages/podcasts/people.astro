---
import { publicBuildSnapshot } from "../../lib/public-build-snapshot";
import { publicPageCopy } from "../../lib/public-page-copy";

const publicPage = publicPageCopy["/podcasts/people/"];

import PeopleView from "../../components/podcasts/PeopleView";
import Console from "../../layouts/Console.astro";

const initial = publicBuildSnapshot.people ?? undefined;
---

<Console
  title={publicPage.title}
  heading={publicPage.heading}
  description={publicPage.description}
  nav="podcasts-people"
  breadcrumbs={[{ label: "podcasts", href: "/podcasts/claims/" }, { label: "people" }]}
>
  <PeopleView initial={initial} client:load />
</Console>
