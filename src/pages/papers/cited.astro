---
import { publicBuildSnapshot } from "../../lib/public-build-snapshot";
import { publicPageCopy } from "../../lib/public-page-copy";

const publicPage = publicPageCopy["/papers/cited/"];

import { CitedView } from "../../components/papers/PublicTables";
import Console from "../../layouts/Console.astro";

const initial = publicBuildSnapshot.cited ?? undefined;
---

<Console
  title={publicPage.title}
  heading={publicPage.heading}
  description={publicPage.description}
  nav="papers-cited"
  breadcrumbs={[{ label: "research papers", href: "/papers/" }, { label: "cited works" }]}
>
  <CitedView initial={initial} client:load />
</Console>
