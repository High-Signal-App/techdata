---
import { createPapersAdapter } from "../../adapters/papers";
import { CitedView } from "../../components/papers/PublicTables";
import Console from "../../layouts/Console.astro";

const initial = await createPapersAdapter({
  fetch: (url, init) => fetch(url, { ...init, signal: AbortSignal.timeout(15000) }),
})
  .citedWorks()
  .catch(() => undefined);
---

<Console
  title="cited works · research papers"
  heading="cited works"
  description="Most-cited external works from the public corpus export; aggregate counts only. Research Papers (High Signal), CC-BY 4.0."
  nav="papers-cited"
  breadcrumbs={[{ label: "research papers", href: "/papers/" }, { label: "cited works" }]}
>
  <CitedView initial={initial} client:load />
</Console>
