---
import { createPapersAdapter } from "../../adapters/papers";
import PapersView from "../../components/papers/PapersView";
import Console from "../../layouts/Console.astro";

const initial = await createPapersAdapter({
  fetch: (url, init) => fetch(url, { ...init, signal: AbortSignal.timeout(15000) }),
})
  .papers(new URLSearchParams({ limit: "50" }))
  .catch(() => undefined);
---

<Console
  title="papers · research papers"
  heading="papers"
  description="Selected public arXiv and OpenReview papers with citation metrics and review signals. Research Papers (High Signal), CC-BY 4.0."
  nav="papers-papers"
  breadcrumbs={[{ label: "research papers", href: "/papers/" }, { label: "papers" }]}
>
  <PapersView initial={initial} client:load />
</Console>
