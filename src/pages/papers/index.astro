---
import { publicBuildSnapshot } from "../../lib/public-build-snapshot";
import { publicPageCopy } from "../../lib/public-page-copy";

const publicPage = publicPageCopy["/papers/"];

import PapersView from "../../components/papers/PapersView";
import Console from "../../layouts/Console.astro";

const initial = publicBuildSnapshot.papers ?? undefined;
---

<Console
  title={publicPage.title}
  heading={publicPage.heading}
  description={publicPage.description}
  nav="papers-papers"
  breadcrumbs={[{ label: "research papers", href: "/papers/" }, { label: "papers" }]}
>
  <PapersView initial={initial} client:load />
</Console>
