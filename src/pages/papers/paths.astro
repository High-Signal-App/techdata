---
import { publicBuildSnapshot } from "../../lib/public-build-snapshot";
import { publicPageCopy } from "../../lib/public-page-copy";

const publicPage = publicPageCopy["/papers/paths/"];

import { PathsView } from "../../components/papers/PublicTables";
import Console from "../../layouts/Console.astro";

const initial = publicBuildSnapshot.paths ?? undefined;
---

<Console
  title={publicPage.title}
  heading={publicPage.heading}
  description={publicPage.description}
  nav="papers-paths"
  breadcrumbs={[{ label: "research papers", href: "/papers/" }, { label: "reading paths" }]}
>
  <PathsView initial={initial} client:load />
</Console>
