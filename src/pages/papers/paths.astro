---
import { createPapersAdapter } from "../../adapters/papers";
import { PathsView } from "../../components/papers/PublicTables";
import Console from "../../layouts/Console.astro";

const initial = await createPapersAdapter({
  fetch: (url, init) => fetch(url, { ...init, signal: AbortSignal.timeout(15000) }),
})
  .paths()
  .catch(() => undefined);
---

<Console
  title="reading paths · research papers"
  heading="reading paths"
  description="Attributed reading paths, in published order, with their source and trust notes. Research Papers (High Signal), CC-BY 4.0."
  nav="papers-paths"
  breadcrumbs={[{ label: "research papers", href: "/papers/" }, { label: "reading paths" }]}
>
  <PathsView initial={initial} client:load />
</Console>
