---
import { createPapersAdapter } from "../../adapters/papers";
import { AuthorsView } from "../../components/papers/PublicTables";
import Console from "../../layouts/Console.astro";

const initial = await createPapersAdapter({
  fetch: (url, init) => fetch(url, { ...init, signal: AbortSignal.timeout(15000) }),
})
  .authors()
  .catch(() => undefined);
---

<Console
  title="authors · research papers"
  heading="authors"
  description="Author rankings and their published top arXiv IDs from the public export. Research Papers (High Signal), CC-BY 4.0."
  nav="papers-authors"
  breadcrumbs={[{ label: "research papers", href: "/papers/" }, { label: "authors" }]}
>
  <AuthorsView initial={initial} client:load />
</Console>
