---
import { publicBuildSnapshot } from "../../lib/public-build-snapshot";
import { publicPageCopy } from "../../lib/public-page-copy";

const publicPage = publicPageCopy["/papers/authors/"];

import { AuthorsView } from "../../components/papers/PublicTables";
import Console from "../../layouts/Console.astro";

const initial = publicBuildSnapshot.authors ?? undefined;
---

<Console
  title={publicPage.title}
  heading={publicPage.heading}
  description={publicPage.description}
  nav="papers-authors"
  breadcrumbs={[{ label: "research papers", href: "/papers/" }, { label: "authors" }]}
>
  <AuthorsView initial={initial} client:load />
</Console>
