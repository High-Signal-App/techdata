---
import { publicBuildSnapshot } from "../lib/public-build-snapshot";
import { publicPageCopy } from "../lib/public-page-copy";

const publicPage = publicPageCopy["/"];

import { buttonVariants } from "@saas-maker/ui/components/button";
import Overview from "../components/Overview";
import Console from "../layouts/Console.astro";

const rows = publicBuildSnapshot.overview;
---

<Console
  title={publicPage.title}
  heading={publicPage.heading}
  description={publicPage.description}
  nav="overview"
  breadcrumbs={[{ label: "overview" }]}
>
  <Fragment slot="actions">
    <a href="/nomad/" class={buttonVariants({ size: "lg", className: "min-h-11" })}>Explore places</a>
  </Fragment>
  <Overview rows={rows} client:load />
</Console>
