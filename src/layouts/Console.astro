---
import { ConsolePage } from "@saas-maker/templates/console-page";
import figtreeFont from "@saas-maker/ui/fonts/figtree-latin-normal.woff2?url";
import geistFont from "@saas-maker/ui/fonts/geist-latin-normal.woff2?url";
import GlobalSearch from "../components/GlobalSearch";
import CompareTray from "../components/views/CompareTray";
import SavedViews from "../components/views/SavedViews";
import { consoleNav, type NavKey } from "../lib/nav";
import { type PublicPath, publicPageCopy } from "../lib/public-page-copy";
import "../styles/app.css";

interface Props {
  /** Document title (without the app name). */
  title: string;
  heading: string;
  description: string;
  nav: NavKey;
  breadcrumbs: { label: string; href?: string }[];
}

const { title, heading, description, nav, breadcrumbs } = Astro.props;
const metaDescription =
  description.length > 160
    ? "Cost of living, internet and everyday-life scores for 1,374 places in 205 countries and territories, from the Nomad Atlas snapshot."
    : description;
const documentTitle = `${title} · techdata`;
const publicPage =
  publicPageCopy[(Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "") + "/") as PublicPath];
const markdownHref = Astro.url.pathname === "/" ? "/index.md" : Astro.url.pathname.replace(/\/$/, "") + ".md";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" data-theme="base" data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeFont} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "WebPage", name: documentTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) })} />
    <title>{documentTitle}</title>
    <meta name="description" content={metaDescription} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="techdata" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {publicPage && <><meta name="ai-summary" content={description} /><link rel="alternate" type="text/markdown" href={markdownHref} /></>}
    {Astro.url.pathname === "/" && <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite",name:"techdata",...(Astro.site?{url:Astro.site.origin}:{})})} />}
    <script>
      import { APP_HEALTH_PUBLIC_KEY, shouldCollectBrowserAnalytics } from "../lib/app-health-config";

      if (shouldCollectBrowserAnalytics(new URL(window.location.href))) {
        const tracker = document.createElement("script");
        tracker.src = "https://health.sassmaker.com/tracker.js";
        tracker.dataset.key = APP_HEALTH_PUBLIC_KEY;
        tracker.dataset.project = "app-6e8591c2-a780-4de5-8360-4461ad3d1f33";
        tracker.dataset.identity = "persistent";
        tracker.dataset.endpoint = "https://ingest.sassmaker.com/v1/browser";
        document.head.appendChild(tracker);
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:shadow-lg"
      >Skip to content</a
    >
    <ConsolePage
      brand={{ name: "techdata", href: "/" }}
      nav={consoleNav(nav)}
      breadcrumbs={[{ label: "techdata", href: "/" }, ...breadcrumbs]}
      title={heading}
      description={description}
      search={{ label: "Search collections…" }}
    >
      <div slot="sidebarFooter">
        <SavedViews client:visible />
        <p class="mt-3">public workbench · read-only, with sources and collection dates.</p>
      </div>
      <slot name="actions" slot="actions" />
      <slot />
      <CompareTray client:visible />
      <footer class="mt-10 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted-foreground">
        <span>sources</span>
        <a class="underline underline-offset-4" href="https://nomad.significanthobbies.com/">Nomad Atlas</a>
        <a class="underline underline-offset-4" href="https://nomads.com/">Nomads.com</a>
        <a class="underline underline-offset-4" href="https://podcasts.highsignal.app/">High Signal Podcasts</a>
        <a class="underline underline-offset-4" href="https://reddit-insights.highsignal.app/">Reddit Insights</a>
        <a class="underline underline-offset-4" href="https://www.producthunt.com/">Product Hunt</a>
        <a class="underline underline-offset-4" href="https://github.com/Significant-Hobbies/ph-catalog">PH Catalog</a>
        <a class="underline underline-offset-4" href="https://papers.highsignal.app/">Research Papers</a>
        <a class="underline underline-offset-4" href="https://creativecommons.org/licenses/by/4.0/">CC-BY 4.0 (Research Papers)</a>
        <p class="basis-full">Usage measurement records page views with a first-party browser ID that can persist for up to 90 days. Search text is excluded.</p>
      </footer>
    </ConsolePage>
    <GlobalSearch client:search />
    <script>
      import "../client/prefetch";
    </script>
  </body>
</html>
